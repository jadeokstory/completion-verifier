{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:completion-verifier:schema:contract:1",
  "title": "Completion Verifier contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "gate", "checks"],
  "properties": {
    "version": {
      "const": 1
    },
    "gate": {
      "$ref": "#/$defs/identifier"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/commandCheck" },
          { "$ref": "#/$defs/fileCheck" }
        ]
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "commandCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "command", "timeout_seconds"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "const": "command"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "fileCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "path", "freshness"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "const": "file"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
        },
        "freshness": {
          "enum": ["run", "none"]
        },
        "min_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
